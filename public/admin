<!DOCTYPE html>
<html>
<head>
  <title>Admin Dashboard</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <style>
    body {
      margin: 0;
      font-family: Arial;
      background: #0f172a;
      color: white;
      padding: 10px;
    }

    h2 {
      text-align: center;
    }

    .toggle {
      width: 100%;
      padding: 15px;
      font-size: 18px;
      border: none;
      border-radius: 10px;
      margin: 10px 0;
      background: #22c55e;
    }

    .off {
      background: #ef4444;
    }

    .card {
      background: #1e293b;
      padding: 15px;
      border-radius: 12px;
      margin: 10px 0;
    }

    .btns {
      display: flex;
      gap: 10px;
      margin-top: 10px;
    }

    button {
      flex: 1;
      padding: 12px;
      border: none;
      border-radius: 8px;
      font-size: 16px;
    }

    .approve { background: #22c55e; }
    .reject { background: #ef4444; }

    .logout {
      margin-top: 20px;
      width: 100%;
      padding: 12px;
      background: gray;
    }
  </style>
</head>

<body>

<h2>⚡ ADMIN DASHBOARD</h2>

<button id="toggleBtn" class="toggle" onclick="toggleSystem()">SYSTEM: ON</button>

<div id="requests"></div>

<button class="logout" onclick="logout()">Logout</button>

<script>
let systemOn = true;

// Dummy data (abhi testing ke liye)
let data = [
  { user: "Rahul", plan: "1 DAY" },
  { user: "Amit", plan: "7 DAYS" }
];

function render(){
  let html = "";

  data.forEach((item, i) => {
    html += `
      <div class="card">
        <p><b>User:</b> ${item.user}</p>
        <p><b>Plan:</b> ${item.plan}</p>

        <div class="btns">
          <button class="approve" onclick="approve(${i})">Approve</button>
          <button class="reject" onclick="reject(${i})">Reject</button>
        </div>
      </div>
    `;
  });

  document.getElementById("requests").innerHTML = html;
}

function approve(i){
  alert("Approved: " + data[i].user);
  data.splice(i,1);
  render();
}

function reject(i){
  alert("Rejected: " + data[i].user);
  data.splice(i,1);
  render();
}

function toggleSystem(){
  systemOn = !systemOn;

  let btn = document.getElementById("toggleBtn");

  if(systemOn){
    btn.innerText = "SYSTEM: ON";
    btn.classList.remove("off");
  } else {
    btn.innerText = "SYSTEM: OFF";
    btn.classList.add("off");
  }
}

function logout(){
  window.location.href = "/admin";
}

render();
</script>

</body>
</html>
